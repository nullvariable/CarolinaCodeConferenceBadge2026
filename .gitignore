# Claude Code workspace state.
.claude/

# Local WiFi credentials — copy settings.toml.example and edit locally.
settings.toml

# Local secrets (Ollama cloud API key for the Doomish relay). Never commit.
.env
*.env
relay/relay.env

# CircuitPython auto-generated boot log (contains the specific board's UID + MAC).
boot_out.txt

# CircuitPython bytecode caches (rare on CIRCUITPY, but just in case).
__pycache__/
*.py[cod]

# Desktop simulator venv. Repo-only, like img/ — never copied to the badge.
sim/.venv/

# Editor / OS scratch files that end up on the CIRCUITPY drive.
*.tmp
*.swp
*.swo
*~

# macOS metadata
.DS_Store
.fseventsd/
.Spotlight-V100
.Trashes
.metadata_never_index
._*

# Windows metadata
Thumbs.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/

# Syncthing metadata
.stfolder/
.stversions/
